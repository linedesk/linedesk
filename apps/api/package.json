{
  "name": "@linedesk/api",
  "private": true,
  "type": "module",
  "exports": {
    "./auth-types": "./src/auth-types.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "user:create": "tsx --env-file=../../.env src/user-create.ts",
    "user:passkeys": "tsx --env-file=../../.env src/user-passkeys.ts",
    "setup:code": "node --env-file-if-exists=../../.env src/setup-code.ts",
    "providers:import": "node --env-file-if-exists=../../.env src/providers-import.ts",
    "workspace:create": "node --env-file-if-exists=../../.env src/workspace-create.ts",
    "demo:workspace": "node --env-file-if-exists=../../.env src/demo-workspace.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "email:preview": "node --env-file-if-exists=../../.env src/emails/preview-cli.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.19",
    "@hono/node-server": "^2.1.8",
    "@linedesk/actions": "workspace:*",
    "@linedesk/calendar": "workspace:*",
    "@linedesk/db": "workspace:*",
    "@linedesk/i18n": "workspace:*",
    "@linedesk/scrub": "workspace:*",
    "@linedesk/telephony": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@sentry/node": "11.12.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.25",
    "date-holidays": "3.39.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "nodemailer": "^10.5.0",
    "pg-boss": "^12.38.2",
    "undici": "^7.30.2",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "@types/web-push": "3.6.4",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}