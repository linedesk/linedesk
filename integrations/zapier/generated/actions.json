  {
    "name": "call.markNotSpam",
    "key": "call_mark_not_spam",
    "kind": "create",
    "label": "Mark Call as Not Spam",
    "noun": "Call",
    "description": "Take a call out of spam: it was a real caller, so it goes back to the open inbox (as a callback unless an outcome is given).",
    "permission": "call:write",
    "fields": [
      {
        "key": "callId",
        "label": "Call",
        "type": "string",
        "required": true,
        "helpText": "The Call ID, e.g. from the Call Finished trigger.",
        "dynamic": "calls"
      },
      {
        "key": "outcome",
        "label": "Outcome",
        "type": "string",
        "required": false,
        "choices": [
          "booked",
          "rescheduled",
          "cancelled",
          "callback",
          "message",
          "answered",
          "transferred",
          "hangup"
        ]
      }
    ]
  },
  {
    "name": "call.setActionItems",
    "key": "call_set_action_items",
    "kind": "create",
    "label": "Set Call Next Steps",
    "noun": "Call",
    "description": "Replace the next steps of a call, for example to tick one off.",
    "permission": "call:write",
    "fields": [
      {
        "key": "callId",
        "label": "Call",
        "type": "string",
        "required": true,
        "helpText": "The Call ID, e.g. from the Call Finished trigger.",
        "dynamic": "calls"
      },
      {
        "key": "items",
        "label": "Next Steps",
        "type": "string",
        "required": true,
        "children": [
          {
            "key": "text",
            "label": "Text",
            "type": "string",
            "required": true
          },
          {
            "key": "done",
            "label": "Done",
            "type": "boolean",
            "required": false
          }
        ]
      }
    ]
  },
  {
    "name": "call.setUrgency",
    "key": "call_set_urgency",
    "kind": "create",
    "label": "Set Call Urgency",
    "noun": "Call",
    "description": "Set how urgent a call is: urgent puts it at the top of the inbox; normal or low takes the flag off.",
    "permission": "call:write",
    "fields": [
      {
        "key": "callId",
        "label": "Call",
        "type": "string",
        "required": true,
        "helpText": "The Call ID, e.g. from the Call Finished trigger.",
        "dynamic": "calls"
      },
      {
        "key": "urgency",
        "label": "Urgency",
        "type": "string",
        "required": true,
        "choices": [
          "urgent",
          "normal",
          "low"
        ]
      }
    ]
  },
  {
    "name": "call.export",
    "key": "call_export",
    "kind": "create",
    "label": "Export Calls",
    "noun": "Export",
    "description": "The calls of a date range as CSV (or, with format table, as header and rows): time, caller, number, urgency, outcome, title, summary and next steps. Owners and admins; at most 10000 calls (`truncated` says when there were more).",
    "permission": "call:export",
    "fields": [
      {
        "key": "from",
        "label": "From",
        "type": "date",
        "required": true,
        "helpText": "First day, YYYY-MM-DD, in the business time zone."
      },
      {
        "key": "to",
        "label": "To",
        "type": "date",
        "required": true,
        "helpText": "Last day, YYYY-MM-DD, in the business time zone (included)."
      },
      {
        "key": "format",
        "label": "Format",
        "type": "string",
        "required": false,
        "helpText": "csv: the file as text (default); table: the same header and cells as lists, for a spreadsheet.",
        "choices": [
          "csv",
          "table"
        ],
        "default": "csv"
      }
    ]
  },
