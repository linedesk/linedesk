  {
    "name": "call.markSpam",
    "key": "call_mark_spam",
    "kind": "create",
    "label": "Mark Call as Spam",
    "noun": "Call",
    "description": "File a call as spam (a sales call or robocall).",
    "permission": "call:write",
    "destructive": true,
    "fields": [
      {
        "key": "callId",
        "label": "Call",
