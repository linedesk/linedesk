  {
    "name": "call.assign",
    "key": "call_assign",
    "kind": "create",
    "label": "Assign Call",
    "noun": "Call",
    "description": "Assign a call to a member of the workspace (their userId from member.list), or unassign it with userId null. The member is notified unless notify is false.",
    "permission": "call:write",
    "fields": [
      {
        "key": "callId",
        "label": "Call",
        "type": "string",
        "required": true,
        "helpText": "The Call ID, e.g. from the Call Finished trigger.",
        "dynamic": "calls"
      },
      {
        "key": "userId",
        "label": "Team Member",
        "type": "string",
        "required": true,
        "nullable": true,
        "helpText": "Leave empty to unassign the call.",
        "dynamic": "members"
      },
      {
        "key": "notify",
        "label": "Notify Them",
        "type": "boolean",
        "required": false
      }
    ]
  },
