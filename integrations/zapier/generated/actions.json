  {
    "name": "calendar.findSlots",
    "key": "calendar_find_slots",
    "kind": "search",
    "label": "Find Free Slots",
    "noun": "Slot",
    "description": "Find free slots for an appointment type: working hours minus existing bookings, buffers and minimum notice.",
    "permission": "calendar:read",
    "list": "slots",
    "fields": [
      {
        "key": "appointmentTypeId",
        "label": "Appointment Type",
        "type": "string",
        "required": true,
        "dynamic": "appointment_types"
      },
      {
        "key": "from",
        "label": "From",
        "type": "datetime",
        "required": false
      },
      {
        "key": "to",
        "label": "To",
        "type": "datetime",
        "required": false
      },
      {
        "key": "fromDate",
        "label": "From Day",
        "type": "date",
        "required": false
      },
      {
        "key": "toDate",
        "label": "To Day",
        "type": "date",
        "required": false
      },
      {
        "key": "calendarId",
        "label": "Calendar",
        "type": "string",
        "required": false,
        "dynamic": "calendars"
      },
      {
        "key": "limit",
        "label": "Limit",
        "type": "integer",
        "required": false,
        "default": 20
      }
    ]
  },
  {
    "name": "appointment.book",
    "key": "appointment_book",
    "kind": "create",
    "label": "Book Appointment",
    "noun": "Booking",
    "description": "Book an appointment into one of the assistant's calendars: checks the slot is still free, writes the calendar event (caller, number, reason, address) and stores the booking, linked to the call.",
    "permission": "calendar:write",
    "fields": [
      {
        "key": "appointmentTypeId",
        "label": "Appointment Type",
        "type": "string",
        "required": true,
        "dynamic": "appointment_types"
      },
      {
        "key": "calendarId",
        "label": "Calendar",
        "type": "string",
        "required": true,
        "dynamic": "calendars"
      },
      {
        "key": "start",
        "label": "Start",
        "type": "datetime",
        "required": true,
        "helpText": "The start time; it must be a free slot (Find Free Slots)."
      },
      {
        "key": "callerName",
        "label": "Caller Name",
        "type": "string",
        "required": false
      },
      {
        "key": "reason",
        "label": "Reason",
        "type": "string",
        "required": true
      },
      {
        "key": "address",
        "label": "Address",
        "type": "string",
        "required": false
      },
      {
        "key": "callerPhone",
        "label": "Caller Phone",
        "type": "string",
        "required": false
      },
      {
        "key": "callerEmail",
        "label": "Caller Email",
        "type": "string",
        "required": false
      },
      {
        "key": "callId",
        "label": "Call",
        "type": "string",
        "required": false,
        "helpText": "The Call ID, e.g. from the Call Finished trigger.",
        "dynamic": "calls"
      }
    ]
  },
