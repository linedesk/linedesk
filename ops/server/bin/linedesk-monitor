#!/bin/bash
# External uptime checks for another Linedesk install, run from a different server (another provider or region) every
# 2 minutes (linedesk-monitor.timer). LINEDESK_MONITOR_HOST (web, API, LiveKit) and LINEDESK_MONITOR_SIP_HOST (SIP)
# in /etc/linedesk/ops.env. A check counts as down after 2 failures in a row; one email when it goes down, one when it
# is back (linedesk-alert-text, SMTP of this server's stack).
set -u
[ -r /etc/linedesk/ops.env ] && . /etc/linedesk/ops.env
host=${LINEDESK_MONITOR_HOST:?set LINEDESK_MONITOR_HOST in /etc/linedesk/ops.env}
sip_host=${LINEDESK_MONITOR_SIP_HOST:-$host}
for h in "$host" "$sip_host"; do
  [[ $h =~ ^[A-Za-z0-9.-]+$ ]] || { echo "linedesk-monitor: not a host name: $h" >&2; exit 1; }
done
dir=${STATE_DIRECTORY:-/var/lib/linedesk-monitor}
mkdir -p "$dir"

http_is() { # <url> <expected code>
  [ "$(curl -s -o /dev/null -m 10 -w '%{http_code}' "$1")" = "$2" ]
}
check() { # <name>
  case $1 in
    api) http_is "https://$host/v1/auth-methods" 200 ;;
    web) http_is "https://$host/" 200 ;;
    livekit) http_is "https://$host/rtc/validate" 401 ;;
    sip) timeout 6 bash -c 'exec 3<>"/dev/tcp/$1/5060"' _ "$sip_host" ;;
  esac
}
describe() { # <name>
  case $1 in
    api) echo "GET https://$host/v1/auth-methods answers 200" ;;
    web) echo "GET https://$host/ answers 200" ;;
    livekit) echo "GET https://$host/rtc/validate answers 401" ;;
    sip) echo "TCP to $sip_host:5060 connects" ;;
  esac
}
mail() { LINEDESK_ALERT_LABEL="$host" /usr/local/sbin/linedesk-alert-text "$1" "$2"; }

for name in api web livekit sip; do
  fails=$(cat "$dir/$name.fails" 2>/dev/null || echo 0)
  state=$(cat "$dir/$name.state" 2>/dev/null || echo up)
  if check "$name"; then
    echo 0 > "$dir/$name.fails"
    if [ "$state" = down ]; then
      echo up > "$dir/$name.state"
      mail "$name is back up" "$name on $host answers again ($(date -u '+%F %T UTC')). Checked from $(hostname)."
    fi
  else
    fails=$((fails + 1)); echo "$fails" > "$dir/$name.fails"
    if [ "$fails" -ge 2 ] && [ "$state" = up ]; then
      echo down > "$dir/$name.state"
      mail "$name is DOWN" "$name on $host failed $fails checks in a row (since about $(date -u -d '-2 min' '+%T UTC')). Check: $(describe "$name"). Checked from $(hostname)."
    fi
  fi
  echo "$name: $(cat "$dir/$name.state" 2>/dev/null || echo up) (fails $(cat "$dir/$name.fails"))"
done
