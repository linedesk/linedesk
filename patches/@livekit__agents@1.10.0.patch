+import os from "node:os";
 import { MultiMutex, Mutex } from "@livekit/mutex";
 import { ThrowsPromise } from "@livekit/throws-transformer/throws";
 import { Queue } from "../utils.js";
 import { JobProcExecutor } from "./job_proc_executor.js";
 import { monotonicUs } from "./job_trace.js";
+import { getCpuMonitor } from "../cpu.js";
+// Linedesk patch (LIN-226): start up to min(4, CPUs) warm processes at once, as the Python SDK does
+// (MAX_CONCURRENT_INITIALIZATIONS); 1.10 starts them one at a time, so after a burst of calls the next callers
+// wait for each process in turn. os.availableParallelism() counts only the CPUs the container may use (cpuset).
+// On upgrade: drop this hunk if the SDK starts warm processes in parallel itself.
+function maxConcurrentInits() {
+  let cpus = os.availableParallelism();
+  try {
+    cpus = Math.min(cpus, Math.ceil(getCpuMonitor().cpuCount()));
+  } catch {
+  }
+  return Math.max(1, Math.min(4, cpus));
+}
 class ProcPool {
   agent;
   initializeTimeout;
@@ -13,7 +27,7 @@ class ProcPool {
   started = false;
   closed = false;
   controller = new AbortController();
-  initMutex = new Mutex();
+  initMutex = new MultiMutex(maxConcurrentInits());
   procMutex;
   // Keep each lock token paired with its warmed process so MultiMutex slots are always released correctly.
   warmedProcQueue = new Queue();
