# Postgres (docker compose: port 5433, wal_level=logical for Electric)
DATABASE_URL=postgres://linedesk:linedesk@localhost:5433/linedesk
# The API tests create their own databases on this server (linedesk_test_<run>), or next to TEST_DATABASE_URL if set
# Electric read sync, only reached through the API proxy
ELECTRIC_URL=http://localhost:3001
# API
PORT=3100
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173
# Encrypts the provider keys set in the admin area (AES-256-GCM). 32 bytes, base64: `openssl rand -base64 32`.
# Without it the admin area cannot store keys; the provider variables below still work. Keep it: without the
# same key the stored keys cannot be read.
SECRETS_KEY=
# Instance admins by email, comma-separated; applies to existing accounts too, once the address is verified
# (sign in once with an email link or a sign-in provider). The first user of an install is an instance admin anyway.
INSTANCE_ADMIN_EMAILS=
# Token the voice agent uses to call the API
AGENT_API_TOKEN=change-me
# API the voice agent and the call simulator write to
LINEDESK_API_URL=http://localhost:3100
# LiveKit (docker compose: `pnpm voice:up`). The secret must be at least 32 characters.
# Development values; docker compose needs both to be set, and a self-hosted stack refuses these two.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-at-least-32-chars
# Where browsers reach LiveKit for test calls from the web app; empty: LIVEKIT_URL. In the self-host stack Caddy
# serves LiveKit's signalling at /rtc on the site itself: set the site's address with ws:// or wss:// (e.g. wss://desk.example.com)
LIVEKIT_PUBLIC_URL=
# scripts/tunnel.sh (try the test call from a phone): user:password that closes the public web tunnel
NGROK_BASIC_AUTH=
# IP LiveKit tells clients to send media to: 127.0.0.1 locally, the server's public IP in production
LIVEKIT_NODE_IP=127.0.0.1
# Public host (and port, if not 5060) of LiveKit SIP that the carrier forwards calls to, e.g. sip.example.com.
# Needed when TELEPHONY_PROVIDER is not dev
LIVEKIT_SIP_ENDPOINT=
# true on a server that carriers reach from the internet, so LiveKit SIP announces its public IP
LIVEKIT_SIP_USE_EXTERNAL_IP=false
# Carrier for phoneNumber.setup: telnyx, twilio, or dev (no carrier, costs nothing). Unset: the carrier picked in the
# admin area, else the first one with keys (Telnyx before Twilio), else dev.
# All provider keys below can also be set in the admin area; a key
# stored there wins over its variable. LiveKit above is part of the install and stays in env.
TELEPHONY_PROVIDER=dev
# Telnyx (the default carrier; portal: API Keys): finds or buys numbers and routes them to LiveKit SIP over an
# FQDN connection named linedesk-livekit (other connections in the account are not touched). The public key verifies its webhooks
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Twilio (second carrier; console: Account Info): Elastic SIP trunking; the auth token also verifies its webhooks
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Call test (pnpm --filter @linedesk/agent call-test <scenario> [--phone]): CALL_TEST_TO is the business number (it names
# the workspace); CALL_TEST_FROM the test caller's Telnyx number for --phone (caller ID, on a connection used only for the test)
CALL_TEST_FROM=
CALL_TEST_TO=
# Optional: another ElevenLabs voice for the test caller, so both sides are easy to tell apart
TEST_CALLER_VOICE_ID=

# CPU load (0 to 1) above which the agent takes no new calls; default 0.95 (LiveKit's own default, 0.7, refuses
# calls on a small single-box server while one call runs)
AGENT_LOAD_THRESHOLD=
# Processes the agent keeps warm for the next call (default 3), and how long a new one may take to load
# (default 60000 ms; the library's 10 s is too short on a small box while a call runs)
AGENT_IDLE_PROCESSES=
AGENT_INIT_TIMEOUT_MS=
# Voice agent. It reads its providers from Linedesk (admin area, Providers); for a stage not set up there it uses
# the variables below. Without either it starts anyway and logs each call as missed. Settings are re-read every 30 s.
# Each stage has a default and can be changed: STT_PROVIDER (deepgram), LLM_PROVIDER
# (openrouter | openai), TTS_PROVIDER (elevenlabs | cartesia). Only the keys of the chosen providers are needed.
# Speech to text: Deepgram. STT_MODEL defaults to flux-general-en
DEEPGRAM_API_KEY=
# LLM for the conversation and the call summary: OpenRouter (an OpenAI-compatible API)
OPENROUTER_API_KEY=
# Model ids at the LLM provider (OpenRouter: vendor/model), also editable in Linedesk under Providers.
# A comma-separated list is "model, fallback, ...": OpenRouter tries the next one when a model fails
# (rate limit, outage). Empty: the defaults. LLM_MODEL is for live turns and needs a fast first token
# (default google/gemini-2.5-flash-lite, openai/gpt-4.1-mini; reasoning models such as gpt-5.x take 1 to 5 s).
# SUMMARY_MODEL writes the summary after the call (default google/gemini-2.5-flash, openai/gpt-5.4-mini).
LLM_MODEL=
SUMMARY_MODEL=
# Where the agent keeps the greeting audio (made once per greeting text and voice). Default: the system temp dir
GREETING_CACHE_DIR=
# Text to speech: ElevenLabs. TTS_VOICE_ID sets the default voice (empty: the provider's default);
# an assistant's own voice setting wins when it is for the same provider
ELEVENLABS_API_KEY=
TTS_VOICE_ID=
# Alternatives: LLM_PROVIDER=openai with OPENAI_API_KEY (default model gpt-4.1-mini, no fallbacks), TTS_PROVIDER=cartesia with CARTESIA_API_KEY
# OPENAI_API_KEY=
# CARTESIA_API_KEY=

# Sign-in. Password works out of the box; each of the following switches on when its values are set.
# AUTH_PASSWORD_ENABLED=false            # turn password sign-in off (when SSO or email codes are set up)
# Email sign-in sends a 6-digit code (no link) and needs a way to send email: SMTP, or for development the API log.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# EMAIL_FROM=Linedesk <no-reply@example.com>
# Development only: print emails (and their sign-in codes) to the API log. Remove on a real server.
EMAIL_TO_LOG=true
# Google and Microsoft are also how calendars are connected (Settings, Assistant, Calendar); that needs
# SECRETS_KEY (above) and a second redirect URI per app: <BETTER_AUTH_URL>/v1/calendar/callback/google and
# <BETTER_AUTH_URL>/v1/calendar/callback/microsoft. Google's consent screen lists the scopes calendar.events,
# calendar.freebusy and calendar.calendarlist.readonly; Microsoft's app the delegated Calendars.ReadWrite,
# offline_access and User.Read. Sign-in itself asks only for the account's name and email.
# Google: redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft: redirect URI <BETTER_AUTH_URL>/api/auth/callback/microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Tenant id to limit sign-in to one organization; default common (personal and work accounts). A Microsoft
# sign-in joins or creates an account only when Microsoft proves the email: personal accounts always; work
# accounts only with the optional ID-token claim xms_edov (App registration > Token configuration > Add optional
# claim > ID > xms_edov, and email). Without it, work accounts are refused with a clear message.
# MICROSOFT_TENANT_ID=common
# GitHub: an OAuth app (github.com/settings/developers), callback URL <BETTER_AUTH_URL>/api/auth/callback/github.
# Linedesk asks for read:user and user:email and uses only the account's primary address, and only when
# GitHub has verified it; that address joins an existing Linedesk account with the same email.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Any OpenID Connect provider (Okta, Keycloak, Authentik, ...): redirect URI <BETTER_AUTH_URL>/api/auth/callback/oidc
# The provider must send email_verified=true only for addresses it has verified: a sign-in with a
# verified email joins the Linedesk account with that email.
# OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Company SSO
# Passkeys: on by default. Members add one under Account > Sign-in & security, then sign in with it. They are bound
# to the host name of PUBLIC_URL (or WEB_ORIGIN) and need https (or localhost); a new address means new passkeys.
# AUTH_PASSKEY_ENABLED=false

# A live call with no new transcript line for this many minutes is ended by the API as "Call cut off"
# (its agent went away). Default 10.
# STALE_LIVE_CALL_MINUTES=10

# Call recordings (optional, `pnpm recording:up`). Usually picked in Linedesk under Admin > Providers >
# Recording storage; these variables are the fallback when nothing is picked there.
# Empty: the agent records nothing. file: LiveKit egress writes into a directory the API reads (development,
# simple self-hosting). s3: any S3-compatible bucket (AWS S3, Cloudflare R2, Hetzner, Backblaze B2, MinIO).
RECORDING_STORE=
# Directory for RECORDING_STORE=file (default: data/recordings in the repository)
RECORDINGS_DIR=
# Each workspace keeps recordings 90 days by default (Settings, Recordings); a daily job in the API deletes older ones.
# Background jobs (pg-boss, in the database's pgboss schema) run in the API. false: this API process runs none.
JOBS_ENABLED=true
# For RECORDING_STORE=s3 (fallback for the S3-compatible settings in the admin area): the S3 API endpoint,
# bucket and keys. Egress uploads there with these keys (sent per recording), the API signs links.
# R2: https://<account-id>.r2.cloudflarestorage.com with S3_REGION=auto. Hetzner: https://<location>.your-objectstorage.com
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: a path prefix inside the bucket, and false for bucket.endpoint/key URLs (default: endpoint/bucket/key)
S3_PREFIX=
S3_FORCE_PATH_STYLE=
# Sign-up: false closes it. Nobody creates an account on their own (password, email link or SSO);
# existing users sign in as before, people with a workspace invitation can still join, and an instance
# admin creates accounts with Invite user or `pnpm --filter @linedesk/api user:create --email --name [--admin]`.
AUTH_SIGNUP_ENABLED=true
# Shown under sign-in and in the profile menu when set; hidden when empty. With sign-up closed, sign-in also
# names the support address. TERMS_URL and PRIVACY_URL must be http(s) links.
TERMS_URL=
PRIVACY_URL=
SUPPORT_EMAIL=
# Addresses or IPv4 ranges of the reverse proxies in front of the API, comma-separated. Rate limits use the
# connection's address; only from these proxies is the last X-Forwarded-For hop believed. Docker compose sets
# Docker's private ranges (only Caddy and the agent reach the API there). Development: 127.0.0.1 (the Vite proxy).
TRUSTED_PROXIES=127.0.0.1

# Self-hosting with `docker compose up` (see README). The containers read this file; compose replaces the
# addresses above (DATABASE_URL, ELECTRIC_URL, WEB_ORIGIN, BETTER_AUTH_URL, LIVEKIT_URL, LINEDESK_API_URL,
# RECORDINGS_DIR). It also reads:
# Database password, required: set before the first start, e.g. openssl rand -hex 24
#POSTGRES_PASSWORD=
# Your own LiveKit key and secret are required (the development values above are refused):
#   docker run --rm livekit/livekit-server generate-keys
# Publish the call audio and SIP ports to the outside (default 127.0.0.1); set on a server.
#LIVEKIT_BIND_IP=0.0.0.0
# Address people open, exactly.
#PUBLIC_URL=http://localhost
# Where Caddy listens (plain HTTP). Default: port 80. Behind your own reverse proxy: a local address.
#LINEDESK_HTTP_BIND=127.0.0.1:8480
# Let Linedesk's Caddy get the certificate itself (ports 80 and 443, PUBLIC_URL=https://your.domain):
#COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# Memory limit and CPU quota of a service (README has the defaults), for example:
#LINEDESK_AGENT_MEM=1g
#LINEDESK_API_CPUS=0.2
# The CPU core LiveKit, SIP, the agent and egress share (0 on a machine with one core)
#LINEDESK_VOICE_CPUSET=1
