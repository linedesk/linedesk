# Postgres (docker compose: port 5433, wal_level=logical for Electric)
DATABASE_URL=postgres://callfront:callfront@localhost:5433/callfront
# Electric read sync, only reached through the API proxy
ELECTRIC_URL=http://localhost:3001
# API
PORT=3100
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173
# Token the voice agent uses to call the API
AGENT_API_TOKEN=change-me
# API the voice agent and the call simulator write to
CALLFRONT_API_URL=http://localhost:3100
