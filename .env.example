# Postgres (docker compose: port 5433, wal_level=logical for Electric)
DATABASE_URL=postgres://linedesk:linedesk@localhost:5433/linedesk
# The API tests create their own databases on this server (linedesk_test_<run>), or next to TEST_DATABASE_URL if set
# Electric read sync, only reached through the API proxy
ELECTRIC_URL=http://localhost:3001
# Electric refuses shape requests without it; the API sends it. Development value: on a server set your own
# (openssl rand -hex 24); the API container refuses this one.
ELECTRIC_SECRET=dev-electric-secret-change-me
# API
PORT=3100
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173
# Encrypts the keys connected in Server admin › Providers (AES-256-GCM). 32 bytes, base64: `openssl rand -base64 32`
# (scripts/setup.sh makes it). Without it nothing can be connected in the app. Keep it: without the same key the
# stored keys cannot be read.
SECRETS_KEY=
# The first admin: on a fresh install the API prints a setup code to its log, and the sign-in page asks for it.
# Optional instead: instance admins by email, comma-separated; applies to existing accounts too, once the address
# is verified (an email code or a sign-in provider).
INSTANCE_ADMIN_EMAILS=
# Token the voice agent uses to call the API: at least 32 characters (`openssl rand -hex 24`). This development
# value is refused where NODE_ENV=production (the docker images).
AGENT_API_TOKEN=dev-agent-token-not-for-a-server-0000
# API the voice agent and the call simulator write to
LINEDESK_API_URL=http://localhost:3100
# The number the call simulator dials (`pnpm --filter @linedesk/agent simulate`, or pass --to). Unset: the
# install's only Linedesk number.
# SIM_TO_NUMBER=
# LiveKit (docker compose: `pnpm voice:up`). The secret must be at least 32 characters.
# Development values; docker compose needs both to be set, and a self-hosted stack refuses these two.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-at-least-32-chars
# Where browsers reach LiveKit for test calls from the web app; empty: LIVEKIT_URL. In the self-host stack Caddy
# serves LiveKit's signalling at /rtc on the site itself: set the site's address with ws:// or wss:// (e.g. wss://desk.example.com).
# The proxy allows browsers to connect to this address (Content-Security-Policy connect-src) and to no other ws/wss host.
LIVEKIT_PUBLIC_URL=
# scripts/tunnel.sh (try the test call from a phone): user:password that closes the public web tunnel
NGROK_BASIC_AUTH=
# scripts/local-public.sh (the docker compose stack on a public ngrok address, docs/local.md): user:password for the
# tunnel (made on the first start), and a reserved ngrok domain (empty: the account's own dev domain)
LINEDESK_TUNNEL_AUTH=
NGROK_URL=
# IP LiveKit tells clients to send media to: 127.0.0.1 locally, the server's public IP in production
LIVEKIT_NODE_IP=127.0.0.1
# Public host (and port, if not 5060) of LiveKit SIP that the carrier forwards calls to, e.g. sip.example.com.
# Needed when TELEPHONY_PROVIDER is not dev
LIVEKIT_SIP_ENDPOINT=
# true on a server that carriers reach from the internet, so LiveKit SIP announces its public IP
LIVEKIT_SIP_USE_EXTERNAL_IP=false
# Where LiveKit SIP takes inbound calls from (setup-sip writes it on the inbound trunk): carrier names (their published
# signaling addresses, packages/telephony/src/signaling-addresses.ts) and/or IPs and CIDR ranges, space- or comma-separated.
# Empty: "telnyx twilio". "any" accepts calls from every address (anyone who reaches 5060 can call the assistant)
LIVEKIT_SIP_ALLOWED_ADDRESSES=
# Only when two installs share one Telnyx or Twilio account (staging and production): a short name (letters, digits) added
# to this install's objects there ("linedesk-livekit-prod"), so setting up a number on one never repoints the other's.
# Unset on the install that already uses the account.
LINEDESK_CARRIER_SUFFIX=
# Carrier for phoneNumber.setup: telnyx, twilio, or dev (no carrier, costs nothing). Unset: the carrier picked in the
# admin area, else the first one with keys (Telnyx before Twilio), else dev.
# Phone, speech, language model, voice, email, sign-in (Google, Microsoft, GitHub, OIDC) and recording storage
# are connected in the app: Server admin › Providers. Keys are stored there encrypted with SECRETS_KEY. Every field there
# also has a variable (named in packages/actions/src/admin.ts) that applies while nothing is stored, for
# automated installs; a stored value wins. LiveKit and the secrets above are part of the install and stay here.
# dev: no carrier (development). Empty: the carrier connected in Server admin › Providers.
TELEPHONY_PROVIDER=dev
# Test calls from the web app on the whole install in a day (default 200); each user makes at most 20 a day.
TEST_CALLS_PER_DAY=
# Numbers members who are not instance admins may buy on the install's carrier account, install-wide (defaults 20 and 100).
NUMBER_PURCHASES_PER_DAY=
NUMBER_PURCHASES_PER_30_DAYS=
# Forwarding check ("Check forwarding" on a forwarded number): the install's carrier calls the business from this
# number (E.164, in the install's Telnyx or Twilio account, used by no workspace) and watches for the call to arrive.
# Server admin › Providers, "Forwarding check number" sets it too. Empty: the first number in the account no workspace uses.
TELNYX_CHECK_NUMBER=
TWILIO_CHECK_NUMBER=
# Forwarding checks on the whole install in a day (default 200); per workspace at most 5 an hour and 2 business
# numbers a day, and one business number at most 3 times a day across all workspaces.
FORWARDING_CHECKS_PER_DAY=

# Call test (pnpm --filter @linedesk/agent call-test <scenario> [--phone]): CALL_TEST_TO is the business number (it names
# the workspace); CALL_TEST_FROM the test caller's Telnyx number for --phone (caller ID, on a connection used only for the test)
CALL_TEST_FROM=
CALL_TEST_TO=
# Live warm-transfer test only (docs/architecture.md, "Live transfer test"): the test on-call number. When set, a phone
# call test may be put through to exactly this number, and call-test allows --phone for transfer scenarios. Leave empty.
CALL_TEST_ONCALL=
# Optional: another ElevenLabs voice for the test caller, so both sides are easy to tell apart
TEST_CALLER_VOICE_ID=

# Only set this when more than one agent worker runs. CPU load (between 0 and 1, e.g. 0.8) at which a worker takes no
# new call, so LiveKit gives it to another worker; the same value goes to LiveKit (docker-compose.yml,
# agents.target_load). Empty (the default): a worker never refuses a call because of load. The load is the whole
# machine's, so on a busy server a single worker would otherwise leave calls unanswered; above 95% the agent logs a
# warning instead (at most once a minute)
AGENT_LOAD_THRESHOLD=
# Processes the agent keeps warm for the next call (default 3), and how long a new one may take to load
# (default 60000 ms; the library's 10 s is too short on a small box while a call runs)
AGENT_IDLE_PROCESSES=
AGENT_INIT_TIMEOUT_MS=
# Where the agent keeps the greeting audio (made once per greeting text and voice). Default: the system temp dir
GREETING_CACHE_DIR=
# Where the API keeps voice previews for Settings, Assistant, Voice (made once per voice). Default: the system temp dir
VOICE_PREVIEW_DIR=

# Sign-in. Password and passkeys work out of the box; email codes once email is connected (Server admin › Providers),
# Google, Microsoft, GitHub and OIDC once connected there too.
# AUTH_PASSWORD_ENABLED=false            # turn password sign-in off (when SSO or email codes are set up)
# Development only: print emails (and their sign-in codes) to the API log instead of sending them. Never on
# a server others can reach: anyone who reads the logs can sign in as anyone. For local development, uncomment it.
# EMAIL_TO_LOG=true
# Push notifications need nothing: the first start makes the key pair and stores it.
# Passkeys: on by default. Members add one under Account > Sign-in & security, then sign in with it. They are bound
# to the host name of PUBLIC_URL (or WEB_ORIGIN) and need https (or localhost); a new address means new passkeys.
# AUTH_PASSKEY_ENABLED=false
# Instance admins open the admin area only with a confirmed email address and a recent sign-in: a passkey counts
# 12 hours, any other method 1 hour. Granting admin, resetting passkeys, signing in as a user and actions on other
# admins need a passkey sign-in on top, and every admin is emailed about admin sign-ins without a passkey.
# off: none of this (for installs without https or email); the API warns at every start. Default on.
# Changing passkeys keeps its own rule, also with off. An admin's first passkey needs a
# one-time code: the first admin gets it with `pnpm --filter @linedesk/api user:passkeys --enrol --email <address>`,
# later ones from the admin who grants the role (--enrol ends nothing); `--remove` resets a user's passkeys (a lost
# device) and signs them out, AI agent setup links included.
# ADMIN_SECOND_FACTOR=off

# A live call with no new transcript line for this many minutes is ended by the API as "Call cut off"
# (its agent went away). Default 10.
# STALE_LIVE_CALL_MINUTES=10

# Call recordings are switched on in Server admin › Providers › Recording storage (Local disk or S3-compatible); Local disk
# needs `pnpm recording:up` (LiveKit egress). Directory for Local disk (default: data/recordings in the repository):
RECORDINGS_DIR=
# Each workspace keeps recordings 90 days by default (Settings, Recordings); a daily job in the API deletes older ones.
# Background jobs (pg-boss, in the database's pgboss schema) run in the API. false: this API process runs none.
JOBS_ENABLED=true
# Sign-up, closed by default: nobody creates an account on their own (password, email code or SSO), so a
# fresh server on a public address cannot be used by strangers (their own workspaces, your phone numbers and
# provider keys). Existing users sign in as before, people with a workspace invitation can still join, and an
# instance admin adds people to a workspace with Add user or creates an account with `pnpm --filter @linedesk/api user:create --email --name [--admin]`.
# true opens it: anyone who can reach PUBLIC_URL can create an account and a workspace.
AUTH_SIGNUP_ENABLED=false
# How many workspaces one member can create (the app's New workspace and the setup agent). Unset or empty: no limit.
# A positive whole number sets one, e.g. 5 on a hosted service; anything else stops the API at start. Separately, one
# setup link for an AI agent creates at most 10 workspaces.
# WORKSPACE_LIMIT=
# Setting the install up by hand, step by step with a real test of each part (the small link next to "Set up with an
# AI agent"). off: only the setup checklist in Server admin › Overview, as on a hosted service whose operator set it up.
# LINEDESK_INSTALL_SETUP=off
# How a new workspace is introduced after onboarding: tour (a short product tour), sample ("Try with sample
# calls", removable in one click), both, or off. Default: both.
FIRST_USE=both
# Shown under sign-in and in the profile menu when set; hidden when empty. With sign-up closed, sign-in also
# names the support address. TERMS_URL and PRIVACY_URL must be http(s) links.
TERMS_URL=
PRIVACY_URL=
SUPPORT_EMAIL=
# The partner directory the day-3 setup email links to (agencies that set up the assistant for a business). Empty:
# the setup emails offer no partner. Linedesk Cloud sets https://linedesk.ai/partners. Must be an http(s) link.
PARTNER_DIRECTORY_URL=
# The GitHub star count next to Star on GitHub (the server asks api.github.com about once an hour). Unset: only
# Linedesk Cloud asks; a self-hosted install makes no such request and shows no count. true or false decides.
# GITHUB_STARS=
# Addresses or IPv4 ranges of the reverse proxies in front of the API, comma-separated. Rate limits use the
# connection's address; only from these proxies is the last X-Forwarded-For hop believed. Docker compose sets
# Docker's private ranges (only Caddy and the agent reach the API there). Development: 127.0.0.1 (the Vite proxy).
TRUSTED_PROXIES=127.0.0.1

# Self-hosting with `docker compose up` (see README): `scripts/setup.sh [https://your.domain]` makes .env from this
# file with a random value for every secret (database, Electric, auth, SECRETS_KEY, agent token, LiveKit) and sets
# PUBLIC_URL. The containers read this file; compose replaces the
# addresses above (DATABASE_URL, ELECTRIC_URL, WEB_ORIGIN, BETTER_AUTH_URL, LIVEKIT_URL, LINEDESK_API_URL,
# RECORDINGS_DIR). It also reads:
# Database password, required: set before the first start (scripts/setup.sh does), e.g. openssl rand -hex 24
#POSTGRES_PASSWORD=
# Your own LiveKit key and secret are required (the development values above are refused; scripts/setup.sh makes them)
# Publish the call audio and SIP ports to the outside (default 127.0.0.1); set on a server.
#LIVEKIT_BIND_IP=0.0.0.0
# Address people open, exactly.
#PUBLIC_URL=http://localhost
# Where Caddy listens (plain HTTP). Default: port 80. Behind your own reverse proxy: a local address.
#LINEDESK_HTTP_BIND=127.0.0.1:8480
# Behind your own reverse proxy: where it connects to Caddy from (space-separated addresses or ranges; for a
# proxy on the same host, the Docker gateway range). Caddy then keeps the client address it forwards, so rate
# limits count per client. Empty (default): Caddy trusts no upstream; behind a proxy every client shares one address.
#LINEDESK_TRUSTED_PROXY_RANGES=172.16.0.0/12
# Let Linedesk's Caddy get the certificate itself (ports 80 and 443, PUBLIC_URL=https://your.domain):
#COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# Memory limit and CPU quota of a service (README has the defaults). On your own machine add
# docker-compose.local.yml to COMPOSE_FILE instead (docs/local.md, Resource limits). For example:
#LINEDESK_AGENT_MEM=1g
#LINEDESK_API_CPUS=0.2
# The CPU core LiveKit, SIP, the agent and egress share (0 on a machine with one core)
#LINEDESK_VOICE_CPUSET=1
# Dev mode, for a test server only (docs/dev-mode.md): api, web and agent run from this checkout and pick up
# changes within seconds; scripts/deploy.sh then fast-forwards the checkout instead of building images.
# Empty LINEDESK_MODE: image mode. Keep both lines; the second adds docker-compose.dev.yml only in dev mode.
#LINEDESK_MODE=dev
#COMPOSE_FILE=docker-compose.yml${LINEDESK_MODE:+:docker-compose.$LINEDESK_MODE.yml}
# Dev mode follows this branch (default master-dev, the trunk; docs/ci.md, "Branches").
#LINEDESK_DEV_BRANCH=master-dev
# Dev mode limits (defaults 768m, 768m, 896m; CPUs 1 and 1), for example:
#LINEDESK_DEV_WEB_MEM=1g

# Outbound webhooks go to public https addresses only. true: also http and private addresses (localhost,
# 10.x, 192.168.x): for development, or a server whose webhooks go to its own network. The same rule applies
# to the website import (Settings, Assistant, Knowledge), which reads public http(s) sites only.
WEBHOOK_ALLOW_PRIVATE_URLS=false

# "Find your business" in onboarding (Google Places, key under Server admin › Providers): at most this many Places
# requests per UTC day for the whole server, counted in the database. 0 turns the lookup off.
#BUSINESS_LOOKUP_DAILY_CAP=300
# The same per workspace and day, so one workspace cannot use up the server's day.
#BUSINESS_LOOKUP_WORKSPACE_DAILY_CAP=30

# Every this many hours (1 to 24) the server checks the key of every provider that is set up (the free check, never a
# paid call) and emails the instance admins once when one that calls need starts failing. 0 turns it off.
#PROVIDER_HEALTH_CHECK_HOURS=6

# Local development only: extra origins allowed to sign in, comma-separated (e.g. http://livemode.localhost:8490 next to a tunnel URL).
#LINEDESK_DEV_ORIGINS=

# Offsite database backups (scripts/backup.sh, README "Backups"): the bucket and the age public key go in a
# file of their own, backup.env (chmod 600), never here: the API container reads all of this file, and the
# bucket key can delete every backup. scripts/backup.sh lists the settings.

# Behind Cloudflare's proxy (docker-compose.cloudflare.yml, README "HTTPS"): the directory with the Cloudflare Origin
# CA certificate for PUBLIC_URL's host, origin.pem and origin.key (mode 600, owned by uid 1000, the proxy's user).
#LINEDESK_ORIGIN_CERT_DIR=/opt/linedesk/certs

# Error tracking with Sentry (apps/api/src/error-reporting.ts): off while empty. Errors and warning/error log lines,
# with the member they hit (id, email, name). No transcripts, breadcrumbs, request bodies, cookies, headers or IPs;
# phone numbers, email addresses and secrets in messages are replaced (packages/scrub). API and agent use SENTRY_DSN; the web app
# gets it from the API (or SENTRY_BROWSER_DSN, a separate project) and needs its ingest host in LINEDESK_CSP_CONNECT,
# e.g. https://o123456.ingest.us.sentry.io (the region of the Sentry org).
#SENTRY_DSN=
#SENTRY_BROWSER_DSN=
#SENTRY_ENVIRONMENT=production
#LINEDESK_CSP_CONNECT=
