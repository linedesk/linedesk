{
  "name": "callfront",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres electric",
    "db:generate": "pnpm --filter @callfront/db generate",
    "db:migrate": "pnpm --filter @callfront/db migrate",
    "db:seed": "pnpm --filter @callfront/api seed"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
