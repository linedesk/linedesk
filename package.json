{
  "name": "callfront",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint",
    "format": "biome format --write",
    "test": "turbo run test",
    "db:up": "sh scripts/compose-dev.sh up -d postgres electric",
    "voice:up": "sh scripts/compose-dev.sh up -d redis livekit livekit-sip",
    "recording:up": "sh scripts/compose-dev.sh --profile recording up -d redis livekit livekit-egress",
    "db:generate": "pnpm --filter @callfront/db generate",
    "db:migrate": "pnpm --filter @callfront/db migrate",
    "db:seed": "pnpm --filter @callfront/api seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
